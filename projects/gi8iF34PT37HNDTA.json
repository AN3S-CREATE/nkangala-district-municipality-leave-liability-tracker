            "text": {
              "ops": [
                {
                  "insert": "DIMENSION: Tool Access — FAB: READ-only (view tasks, search docs, check statuses). Side AI: FULL CRUD (create/update/delete tasks, assign users, set priorities, notify, run audits).",
